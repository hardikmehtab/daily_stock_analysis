# Use union merge strategy for changelog
# When multiple concurrent PRs append entries to the end of [Unreleased], Git directly takes lines from both sides without creating conflict markers.
# Applicable to append-only changelog files.
docs/CHANGELOG.md merge=union

# Documentation image/design assets are binary. Prevent GitHub review diffs from
# trying to decode moved binary files as UTF-8.
sources/**/*.ai binary
sources/**/*.gif binary
sources/**/*.ico binary
sources/**/*.jpg binary
sources/**/*.jpeg binary
sources/**/*.png binary
sources/**/*.psd binary
docs/assets/**/*.ai binary
docs/assets/**/*.gif binary
docs/assets/**/*.ico binary
docs/assets/**/*.jpg binary
docs/assets/**/*.jpeg binary
docs/assets/**/*.png binary
docs/assets/**/*.psd binary

# === Enforce LF line endings for file types (directly consumed by kernel/system interpreters) ===
# Shell scripts (entrypoint.sh, any .sh)
*.sh text eol=lf
*.bash text eol=lf

# Dockerfile (including multi-stage or variants)
Dockerfile text eol=lf
Dockerfile.* text eol=lf

# Makefile
Makefile text eol=lf

# Environment variable files (if used by shell directly sourcing)
.env text eol=lf

# === Added: Binary files (prohibit Git from modifying line endings/encoding) ===
# Certificates, keys, etc. (if present)
*.pem binary
*.crt binary
*.key binary
*.p12 binary